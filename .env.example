# API
PORT=8080
API_TOKEN=replace-with-a-long-random-secret
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-secret
SUPABASE_STORAGE_BUCKET=towntales-assets
PYTHON_EXECUTABLE=python3
# Optional: fine-grained GitHub token with Actions:write for immediate workflow dispatch.
# Without this, the public GitHub Actions worker polls the queue every five minutes.
GITHUB_ACTIONS_TOKEN=
RENDERER_SHARED_SECRET=replace-with-another-long-random-secret
MAX_RENDER_SECONDS=90
MAX_CONCURRENT_RENDERS=1

# Renderer
API_BASE_URL=http://localhost:8080
RENDERER_ID=local-renderer
RENDER_OUTPUT_DIR=/tmp/film-studio-renders
REMOTION_CONCURRENCY=2
