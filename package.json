{
  "name": "chatgpt-film-studio",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run dev",
    "dev:renderer": "npm --workspace apps/renderer run dev",
    "build": "npm --workspace packages/contracts run build && npm run build --workspaces --if-present",
    "typecheck": "npm --workspace packages/contracts run typecheck && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && python3 -m unittest discover -s apps/renderer/scripts -p 'test_*.py'",
    "render:smoke": "npm --workspace apps/renderer run render:smoke",
    "render:smoke:multi": "remotion render apps/renderer/src/index.tsx FilmStudioMultiSceneSmoke /tmp/film-studio-multi-scene.mp4 --log=error",
    "render:smoke:vertical": "remotion render apps/renderer/src/index.tsx FilmStudioVerticalSmoke /tmp/film-studio-vertical.mp4 --log=error",
    "render:lemo:smoke": "node vendor/lemo-opuscar/core/render/video.mjs apps/renderer/fixtures/lemo-smoke --fps 30 --workers 2 --out /tmp/film-studio-lemo-smoke.mp4 --size 1280x720",
    "test:audio": "python3 apps/renderer/scripts/audio_pipeline.py --spec apps/renderer/fixtures/audio-smoke.json --video /tmp/film-studio-smoke.mp4 --output /tmp/film-studio-audio-smoke.mp4 --workdir /tmp/film-studio-audio-test",
    "render:lemo:art-deco": "node vendor/lemo-opuscar/core/render/video.mjs apps/renderer/fixtures/lemo-art-deco --fps 30 --workers 2 --out /tmp/film-studio-lemo-art-deco.mp4 --size 1280x720",
    "render:episode01:preview": "remotion render apps/renderer/src/index.tsx TownTalesEpisode01Preview /tmp/towntales-episode-01-preview.mp4 --log=error",
    "render:episode01:production": "remotion render apps/renderer/src/index.tsx TownTalesEpisode01Production /tmp/towntales-episode-01-production.mp4 --log=error",
    "render:smoke:declarative": "remotion render apps/renderer/src/index.tsx FilmStudioDeclarativeSmoke /tmp/film-studio-declarative.mp4 --log=error"
  },
  "engines": {
    "node": ">=22"
  }
}
